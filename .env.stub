WITHINGS__CLIENTID=your_client_id
WITHINGS__CLIENTSECRET=your_client_secret

GARMIN__USERNAME=your_username
GARMIN__PASSWORD=your_password

# enable seq sink
Serilog__WriteTo__2__Name=Seq
Serilog__WriteTo__2__Args__serverUrl=http://localhost:5341
Serilog__WriteTo__2__Args__apiKey=seq_api_key

# custom application name for logging
#Serilog__Properties__Application=WithingsToGarminSync

# default cron schedule, run daily from 6 to 10 AM hourly
CRON_SCHEDULE=0 6-10 * * *

# fix timezone for cron
TZ=Europe/Helsinki
